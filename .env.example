# Copy to .env and replace every placeholder with a secret value.
APP_ENV=production
ADMIN_USERNAME=replace-during-initial-setup
ADMIN_PASSWORD_HASH=pbkdf2$200000$replace$with-generated-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
ALLOWED_ORIGINS=https://your-frontend.example
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# Keep Google credentials server-side only.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEET_ID=replace-with-sheet-id
